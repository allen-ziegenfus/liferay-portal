import .logic as l
import yaml

# Define the data for the ConfigMap
_config_data = {
    "baseName": l.baseName
    "databaseInstanceName": l.databaseInstanceName
    "databaseName": l.databaseName
    "databasePort": l.databasePort
    "gsaEmail": l.gsaEmail
    "gsaName": l.gsaName
    "instanceConnectionName": l.instanceConnectionName
    "namespace": l.namespace
    "projectId": l.projectId
    "region": l.region
}

# Readiness Logic for XR Status with extremely safe lookups
_ctx_res_map = l.obs.get("resources") or {}
_job_entry_ctx = _ctx_res_map.get("liferay-db-grant-job") or {}
_job_obj_ctx = _job_entry_ctx.get("resource") if _job_entry_ctx else {}
_job_status_ctx = _job_obj_ctx.get("status") if _job_obj_ctx else {}
_conditions_ctx = _job_status_ctx.get("conditions") or []
_is_ready_ctx = any c in _conditions_ctx {c.type == "Ready" and c.status == "True"}

_context_items: [any] = [
    # Composition Context ConfigMap
    {
        "apiVersion": "kubernetes.m.crossplane.io/v1alpha1"
        "kind": "Object"
        "metadata": {
            "annotations": {"gotemplating.fn.crossplane.io/composition-resource-name": "composition-context"}
            "name": "{}-composition-context".format(l._metadata.get("name") or "")
        }
        "spec": {
            "forProvider": {
                "manifest": {
                    "apiVersion": "v1"
                    "data": {
                        "variables": yaml.encode(_config_data)
                    }
                    "kind": "ConfigMap"
                    "metadata": {
                        "name": "composition-context"
                        "namespace": l.namespace
                    }
                }
            }
            "managementPolicies": l.managementPolicies
        }
    }
]

_context_status = {
    "status": {"managedServiceDetailsReady": _is_ready_ctx}
}

if option("combined", "false") != "true":
    items = {"items": _context_items, **_context_status}

