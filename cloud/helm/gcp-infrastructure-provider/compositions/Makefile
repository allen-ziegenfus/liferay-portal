MOCK ?= mock.json

LAYERS = backup elasticsearch init k8s managed_service_details overlay security sql storage

.PHONY: all fmt lint test run-all pkg clean $(LAYERS)

all: fmt lint test

fmt:
	kcl fmt *.k
	kcl fmt tests/*.k

lint:
	@for layer in $(LAYERS); \
	do \
		kcl run $${layer}.k -D params='{"oxr": {"spec": {"database": {}}}, "ctx": {"apiextensions.crossplane.io/environment": {}}}' > /dev/null || exit 1; \
	done

test:
	cd tests && \
	PARAMS=$$(cat arz_dev2025_params.json | jq -c) && \
	CLUSTER_REFS=$$(cat cluster_extracted_resources.json | jq -c) && \
	kcl test ./... -D params="$$PARAMS" -D cluster_refs="$$CLUSTER_REFS"

run-all:
	@if [ ! -f $(MOCK) ]; then echo "Please provide a mock.json file."; exit 1; fi
	@for layer in $(LAYERS); \
	do \
		echo "--- Generated by $${layer}.k"; \
		kcl run $${layer}.k -D params=$$(cat $(MOCK) | jq -r '.params | tojson') || exit 1; \
	done

$(LAYERS):
	@if [ ! -f $(MOCK) ]; then echo "Please provide a mock.json file."; exit 1; fi
	kcl run $@.k -D params=$$(cat $(MOCK) | jq -r '.params | tojson')

pkg:
	/home/allenz/go/bin/kpm pkg

generate:
	./scripts/generate_kcl_bindings.sh

clean:
	rm -rf vendor/ kcl.mod.lock
