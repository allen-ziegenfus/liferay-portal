# KCL Task Runner

MOCK ?= mock.json

# Layer list sorted by ASCII (Uppercase before lowercase)
LAYERS = application backup context elasticsearch init k8s overlay security sql storage

.PHONY: all fmt lint test run-all pkg clean $(LAYERS)

# Default task: format, lint, and test.
all: fmt lint test

# Format all KCL files.
fmt:
	kcl fmt *.kcl

# Lint each file individually.
lint:
	@for layer in $(LAYERS); \
	do \
		echo "Linting $${layer}.kcl..."; \
		kcl run logic.k $${layer}.kcl -D params='{"oxr": {"spec": {"database": {}}}, "ctx": {"apiextensions.crossplane.io/environment": {}}}' > /dev/null || exit 1; \
	done

# Run unit tests.
test:
	kcl run init_test.kcl

# Generate a preview of the combined output of all layers.
run-all:
	@if [ ! -f $(MOCK) ]; then echo "Please provide a mock.json file."; exit 1; fi
	@for layer in $(LAYERS); \
	do \
		echo "--- # Generated by $${layer}.kcl"; \
		kcl run logic.k $${layer}.kcl -D params=$$(cat $(MOCK) | jq -r '.params | tojson') || exit 1; \
	done

# Individual layer targets.
$(LAYERS):
	@if [ ! -f $(MOCK) ]; then echo "Please provide a mock.json file."; exit 1; fi
	kcl run logic.k $@.kcl -D params=$$(cat $(MOCK) | jq -r '.params | tojson')

# Package for release.
pkg:
	/home/allenz/go/bin/kpm pkg

# Clean up.
clean:
	rm -rf vendor/ kcl.mod.lock
