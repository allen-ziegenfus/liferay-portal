import crossplane_provider_kubernetes.v1alpha1 as kubernetes
import k8s.api.core.v1 as k8s

schema ManagedServiceDetails:
    """A schema for Liferay managed service details"""
    database_endpoint: str = "localhost"
    database_instance_name: str
    database_port: int | str = "5432"
    database_username: str
    gcs_bucket_name: str
    overlay_bucket_name: str

    string_data: {str:str} = {
        "DATABASE_ENDPOINT": database_endpoint
        "DATABASE_INSTANCE_NAME": database_instance_name
        "DATABASE_PORT": str(database_port)
        "DATABASE_USERNAME": database_username
        "LIFERAY_GCS_BUCKET_NAME": gcs_bucket_name
        "LIFERAY_OVERLAY_BUCKET_NAME": overlay_bucket_name
    }

schema LiferaySecret:
    """A blueprint for K8s Secrets"""
    ctx: any
    data: ManagedServiceDetails
    name: str

    resource = kubernetes.Object {
        metadata = {
            annotations = {
                "crossplane.io/external-name": name
                "gotemplating.fn.crossplane.io/composition-resource-name": "managed-service-details-secret"
            }
            labels = ctx.labels
            name = name
        }
        spec = {
            forProvider = {
                manifest = k8s.Secret {
                    metadata = {
                        labels = ctx.labels
                        name = "managed-service-details"
                        namespace = ctx.namespace
                    }
                    stringData = data.string_data
                    type = "Opaque"
                }
            }
            managementPolicy = ctx.managementPolicies[0] if ctx.managementPolicies else "CreateUpdate"
        }
    }

