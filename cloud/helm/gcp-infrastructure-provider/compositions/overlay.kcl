import .logic as l
import crossplane_provider_upjet_gcp.v1beta1.storage_gcp_upbound_io_v1beta1_bucket as storage_bucket

_items: [any] = []

if l.overlay.enabled:
    _items += [storage_bucket.Bucket {
        metadata = {
            annotations = {"gotemplating.fn.crossplane.io/composition-resource-name": "liferay-overlay-bucket"}
            labels = l.labels
            name = "{}-overlay".format(l.baseName)
        }
        spec = {
            forProvider = {
                forceDestroy = l.forceDestroy
                labels = l.labels
                location = l.overlay.get("region") or l.region
                storageClass = "STANDARD"
                versioning = [{enabled = True}]
            }
            managementPolicies = l.managementPolicies
        }
    }]

    _items += [{
        "apiVersion": "storage.gcp.m.upbound.io/v1beta1"
        "kind": "BucketIAMMember"
        "metadata": {
            "annotations": {"gotemplating.fn.crossplane.io/composition-resource-name": "liferay-gsa-overlay-bucket-iam"}
            "labels": l.labels
        }
        "spec": {
            "forProvider": {
                "bucketRef": {"name": "{}-overlay".format(l.baseName)}
                "member": "serviceAccount:{}".format(l.gsaEmail)
                "role": "roles/storage.objectViewer"
            }
            "managementPolicies": l.managementPolicies
        }
    }]

items = {"items": _items}
