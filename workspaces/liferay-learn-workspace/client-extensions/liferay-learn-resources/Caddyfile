{
        admin off
        auto_https off

        log {
                format json
        }
}

:80 {
        encode gzip
        file_server

        header {
                Access-Control-Allow-Headers *
                Access-Control-Allow-Methods "GET,OPTIONS,POST"
        }

        import /etc/caddy.d/*

        log {
                format json
                output stdout
        }

        respond / 200

        @options method OPTIONS
        respond @options 204

        root * /public_html

        handle_errors {
            @404 expression `{http.error.status_code} == 404`
            handle @404 {
                redir * {$LIFERAY_LEARN_404_URL} 301
            }
        }
}